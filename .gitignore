# Skill evaluation workspaces (local-only — generated by skill-creator runs)
# Sibling pattern (preferred):
plugins/*-workspace/
# Legacy nested pattern (some plugins still produce this):
plugins/*/skills/*-workspace/

# Local-only code analysis artifacts (output of /peruri-code-analyzer:code-check)
plugins/*/.peruri-code-check.md

# Python compile artifacts — embed absolute source paths and shouldn't ship
__pycache__/
*.py[cod]

# Editor / OS noise
.DS_Store
.idea/
.vscode/

# Local secrets — must never live in a marketplace
.env
.env.local
