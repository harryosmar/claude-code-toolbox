# {{project_name}} — generated by web2rag v{{plugin_version}} at {{generated_at}}
# 2 services: api + chroma. NO ollama (operator's eval-judge Ollama lives on a remote host).

services:
  chroma:
    image: chromadb/chroma:0.5.20
    container_name: {{project_name}}-chroma
    restart: unless-stopped
    volumes:
      - ./data/chroma:/chroma/chroma
    environment:
      IS_PERSISTENT: "TRUE"
      ANONYMIZED_TELEMETRY: "FALSE"
    expose:
      - "8000"
    healthcheck:
      test: ["CMD", "curl", "-fs", "http://localhost:8000/api/v2/heartbeat"]
      interval: 5s
      timeout: 3s
      retries: 20

  api:
    build:
      context: .
      dockerfile: docker/Dockerfile.api
    image: {{project_name}}-api:local
    container_name: {{project_name}}-api
    restart: unless-stopped
    depends_on:
      chroma:
        condition: service_healthy
    env_file:
      - .env
    environment:
      CHROMA_HOST: chroma
      CHROMA_PORT: "8000"
    ports:
      - "8787:8787"
    volumes:
      - ./reports:/app/reports
      - ./eval/testsets:/app/eval/testsets
      # Persist HuggingFace + sentence-transformers caches so BGE-M3 +
      # bge-reranker-v2-m3 + Prompt-Guard + toxic-bert + spacy models
      # download ONCE and survive container restarts. Without this, every
      # restart re-downloads ~3 GB and risks OOM during the redownload.
      - api_model_cache:/cache
    healthcheck:
      test: ["CMD", "curl", "-fs", "http://localhost:8787/health"]
      interval: 5s
      timeout: 3s
      retries: 30

volumes:
  api_model_cache:
