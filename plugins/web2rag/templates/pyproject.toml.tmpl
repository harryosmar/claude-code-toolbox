[build-system]
requires = ["setuptools>=68", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "{{project_name}}"
version = "0.1.0"
description = "web2rag-generated RAG chatbot for {{project_name}}"
requires-python = ">=3.11"
readme = "README.md"

# Deps grow with the build steps. Keep them grouped + commented so operators
# see what each block is for and can prune for slimmer images.
dependencies = [
    # ─── step 1: api skeleton ──────────────────────────────────────────────
    "fastapi>=0.115,<0.120",
    "uvicorn[standard]>=0.32,<0.40",
    "pydantic>=2.9,<3",
    "pydantic-settings>=2.5,<3",
    "httpx>=0.27,<0.29",
    "sse-starlette>=2.1,<3",

    # ─── step 2: in-process bilingual embedder + reranker ────────────────
    # Both are MIT-licensed, run on CPU. Together they account for the
    # bulk of api memory at runtime (~800 MB).
    "sentence-transformers>=3.2,<4",
    "transformers>=4.46,<5",
    "torch>=2.4,<3",

    # ─── step 3: ingest stack ────────────────────────────────────────────
    # chromadb client talks to the chroma service in docker-compose.
    "chromadb>=0.5.20,<0.6",
    # trafilatura is the workhorse for HTML→Markdown extraction.
    "trafilatura>=1.12,<2",
    # rank-bm25 is the sparse half of hybrid retrieval (used in step 5).
    "rank-bm25>=0.2.2,<0.3",
    # defusedxml guards sitemap XML parsing against entity-expansion DoS
    # (billion-laughs / quadratic blowup) from untrusted third-party hosts.
    "defusedxml>=0.7,<1",

    # ─── step 4: guard_ingest (free, in-process) ─────────────────────────
    # Presidio for PII detection + anonymisation. Pulls in spacy as a dep;
    # the en_core_web_sm model is downloaded by Dockerfile.api.
    "presidio-analyzer>=2.2,<3",
    "presidio-anonymizer>=2.2,<3",
    "spacy>=3.7,<4",

    # ─── step 5: chat LLM (Claude only — native Citations API) ───────────
    "anthropic>=0.39,<0.50",

    # ─── step 6: guard_output toxicity scoring ───────────────────────────
    # NOTE: we don't depend on `detoxify` (PyPI) — it pins transformers<4.40
    # which conflicts with sentence-transformers>=3.2. We call its underlying
    # multilingual checkpoint `unitary/multilingual-toxic-xlm-roberta`
    # directly via transformers; bilingual EN+ID coverage, no version conflict.
    # sentencepiece is REQUIRED — XLM-RoBERTa's tokenizer uses a SentencePiece
    # model and transformers refuses to load it without this dep present.
    "sentencepiece>=0.2,<1",

    # ─── eval stack: DeepEval (correctness + capability) + DeepTeam (security)
    # We use DeepEval for the correctness AND capability axes, and DeepTeam
    # for security/red-team. DeepEval gives us:
    #   - FaithfulnessMetric / AnswerRelevancyMetric / ContextualPrecision/Recall
    #     (correctness)
    #   - GEval(name=..., criteria=...) for helpfulness + task-completion
    #     (capability — auto-eval proxy alongside production thumbs feedback)
    #   - Synthesizer for test-set generation
    # DeepTeam reuses DeepEval's model surface, so a single judge factory
    # drives every audit subcommand. No RAGAS — switching means one
    # framework, one base class, one test-case shape.
    "deepeval>=2.0,<4",
    "deepteam>=0.1,<1",
]


[tool.setuptools.packages.find]
include = ["server*", "eval*"]
